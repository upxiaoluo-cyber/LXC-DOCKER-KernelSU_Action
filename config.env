# ==============================================================================
# 内核源码配置
# ==============================================================================
# 内核源码地址（已更新为 crDroid 官方 blossom 内核仓库）
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_blossom.git
# 内核源码分支（对应 Android 16.0）
KERNEL_SOURCE_BRANCH=16.0
# 内核编译配置 ⚠️ 改为更通用的 mt6765 配置（请根据实际 ls 输出调整）
KERNEL_CONFIG=mt6765_defconfig
# 内核Image.gz-dtb or Image
KERNEL_IMAGE_NAME=Image
ARCH=arm64
# 参数
EXTRA_CMDS:LD=ld.lld
EXTRA_CMDT:LLVM=1
EXTRA_CMDU:LLVM_IAS=1

# ==============================================================================
# 编译方案配置
# ==============================================================================
# 编译方案 'A'=clang+gcc编译 'B'=clang编译
METHOD_OK=A

# 编译器选择 'true'=使用自定义编译器Clang 'false'=使用AOSP编译器
USE_CUSTOM_CLANG=true

# Python切换（true=切换到python2）
CUT_PYTHON=false

# ==============================================================================
# 自定义编译器 Clang
# ==============================================================================
CUSTOM_CLANG_SOURCE=https://github.com/AOSP-12/prebuilts_clang_host_linux-x86_clang-r445002.git
CUSTOM_CLANG_BRANCH=12

# 如果使用自定义clang为false，则不要更改此项
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# ==============================================================================
# AOSP 编译器配置（仅供参考）
# ==============================================================================
# 分支:
#   main, android-gs-bluejay-5.10-android13, android-msm-bonito-4.9-android12-qpr1,
#   android-msm-coral-4.14-android13, 3289846, r450784e, r475365b, r487747c, r498229
# 版本:
#   r416183b, r450784d, r450784e, r383902, r399163b
CLANG_BRANCH=android-gs-bluejay-5.10-android13
CLANG_VERSION=clang-r416183b

# ==============================================================================
# LXC / Docker 配置
# ==============================================================================
# 开启 LXC and Docker
LXC_DOCKER=false

# 是否打入LXC补丁
LXC_PATCH=false

# 关闭 CONFIG_ANDROID_PARANOID_NETWORK（解决Docker/LXC网络问题）
ANDROID_PARANOID_NETWORK_OFF=false

# ==============================================================================
# 🆕 SukiSU-Ultra 配置（替换 KernelSU）
# ==============================================================================
# 启用 SukiSU-Ultra
ENABLE_SUKISU=true

# SukiSU 版本（建议使用 main 分支或最新 tag）
# 可用版本参考: https://github.com/SukiSU-Ultra/SukiSU-Ultra/releases
SUKISU_VERSION=main

# SukiSU 官方仓库地址（如需更换可修改）
SUKISU_SOURCE=https://github.com/SukiSU-Ultra/SukiSU-Ultra

# 集成方式: kprobe（推荐）/ manual
# 如果使用 kprobe 方式，需确保 CONFIG_KPROBES=y
SUKISU_INTEGRATION_METHOD=kprobe

# ==============================================================================
# 额外内核配置
# ==============================================================================
DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

# ==============================================================================
# KVM 配置
# ==============================================================================
ENABLE_KVM=false

# ==============================================================================
# 缓存与输出配置
# ==============================================================================
# 开启 Ccache 缓存
ENABLE_CCACHE=true

# DTBO image（是否生成）
NEED_DTBO=false

# 构建 boot.img
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/upxiaoluo-cyber/LXC-DOCKER-KernelSU_Action/releases/download/1/boot.img
